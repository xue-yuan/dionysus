PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dionysus
# disable | require | verify-ca | verify-full
DB_SSLMODE=disable

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Requests per minute per address. A session browsing the archive makes a few
# dozen; this is set well above that. 0 turns the limiter off — on Vercel it
# would count per instance and cannot tell visitors apart.
RATE_LIMIT=240

# Apply schema.sql before listening. Set to false on Vercel, where every cold
# start would re-run it; `seed` applies the schema there instead.
MIGRATE_ON_START=true
